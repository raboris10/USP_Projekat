# =====================================================================
# ŠABLON - kopirajte ovaj fajl u .env i upišite SVOJE vrednosti:
#   CMD:      copy .env.example .env
#   Git Bash: cp .env.example .env
# .env se NE stavlja na GitHub (nalazi se u .gitignore).
# Ovde su samo zamenske vrednosti, ne prave lozinke.
# =====================================================================

# --- Baza ---
# Lozinke izmislite sami. Važe samo za vašu lokalnu bazu.
# Ako ih promenite posle prvog pokretanja: docker compose down -v
DB_NAME=consultme_db
DB_USER=consultme
DB_PASSWORD=promeni_me
DB_ROOT_PASSWORD=promeni_me_root

# --- JWT ---
# Tajni ključ kojim backend potpisuje tokene (bar 32 znaka, nasumičan tekst).
# Napravite svoj u Git Bash-u:  openssl rand -hex 32
# i nalepite rezultat umesto teksta ispod.
JWT_SECRET=ovde_nalepite_svoj_nasumicni_kljuc_od_bar_32_znaka
# Posle koliko minuta token ističe i korisnik mora ponovo da se prijavi
JWT_TRAJANJE_MINUTA=120

# --- Portovi na VAŠEM računaru (leva strana u "ports" u docker-compose.yml) ---
# Ako promenite DB_HOST_PORT, promenite i podrazumevani port u
# backend/src/main/resources/application.properties (bitno samo za pokretanje iz Eclipse-a).
DB_HOST_PORT=8089
BACKEND_HOST_PORT=8088
FRONTEND_HOST_PORT=8087